# 공개(브라우저에 노출되는) 값만 넣습니다. 실제 값은 .env.local(커밋 금지) 또는 GitHub Actions Variables에 넣으세요.
# Supabase 프로젝트 URL (예: https://abcd1234.supabase.co)
VITE_SUPABASE_URL=
# Supabase publishable(anon) 키. service_role/secret 키는 절대 넣지 마세요.
VITE_SUPABASE_PUBLISHABLE_KEY=
# 배포 경로. 프로젝트 사이트면 /저장소명/ , 사용자 사이트/커스텀 도메인이면 / (Actions에서는 자동 설정)
BASE_PATH=/
# 개발 데모 버튼. 운영(production) 빌드에서는 true로 두면 빌드가 실패합니다.
VITE_ENABLE_DEMO=false
